	"Nw Gui Pane Story": {
		"prefix": "/snzp",
		"description": "",
		"body": [
			"--[[",
			"\tAuthor(s): ScottFaber",
			"\tModule: $TM_FILENAME_BASE.lua",
			"]]",
			"",
			"local ServerScriptService = game:GetService(\"ServerScriptService\")",
			"local UserInputService = game:GetService(\"UserInputService\")",
			"",
			"local Framework = require(game.ReplicatedStorage.Submodules.Framework)",
			"",
			"local Maid = shared(\"Maid\") ---@module Maid",
			"local ${TM_FILENAME_BASE/^(.*)\\..*/$1/} = shared(\"${TM_FILENAME_BASE/^(.*)\\..*/$1/}\") ---@module ${TM_FILENAME_BASE/^(.*)\\..*/$1/}",
			"",
			"local maid = Maid.new()",
			"",
			"local function create(props)",
			"\tlocal pane = ${TM_FILENAME_BASE/^(.*)\\..*/$1/}.new()",
			"\tpane:_uiLabsStory({",
			"\t\tProps = props,",
			"\t})",
			"\tmaid:GiveTask(pane)",
			"",
			"\tmaid:GiveTask(UserInputService.InputBegan:Connect(function(input)",
			"\t\t-- if input.KeyCode == Enum.KeyCode.C then",
			"\t\t-- end",
			"\tend))",
			"end",
			"",
			"local function destroy()",
			"\tmaid:Destroy()",
			"end",
			"",
			"local story = {",
			"\trender = function(props)",
			"\t\ttask.spawn(create, props)",
			"\t\treturn function()",
			"\t\t\ttask.spawn(destroy)",
			"\t\tend",
			"\tend,",
			"}",
			"",
			"return story",
		],
	},

